{
  "id": "incus",
  "name": "Incus",
  "version": "0.1.0",
  "description": "Incus containers and VMs on your hosts over SSH: usage, processes, logs, a shell and actions, with per-host levels and secret values kept out of view.",
  "author": {
    "name": "deconstructionalism",
    "url": "https://github.com/deconstructionalism"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/deconstructionalism/termix-plugin-incus",
  "docs": "https://github.com/deconstructionalism/termix-plugin-incus/tree/main/docs",
  "category": "Infrastructure",
  "icon": "Boxes",
  "features": [
    "Containers and VMs on each host, with state, addresses, CPU, memory and disk",
    "Per host levels: read, operate or manage, set only by admins",
    "Secret values in instance config never leave the server"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.2-0",
    "api": "^2.8.0"
  },
  "capabilities": [
    "hosts:read",
    "ssh:connect",
    "credentials:use",
    "network:serve",
    "ui:surface",
    "operations:provide"
  ],
  "sandbox": {
    "schedules": [],
    "events": []
  },
  "contributes": {
    "tabs": [
      {
        "id": "incus",
        "titleKey": "tab.title",
        "icon": "Boxes",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "read",
        "titleKey": "permissions.read.title",
        "descriptionKey": "permissions.read.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "operate",
        "titleKey": "permissions.operate.title",
        "descriptionKey": "permissions.operate.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "shell",
        "titleKey": "permissions.shell.title",
        "descriptionKey": "permissions.shell.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 35,
        "enableKey": "enableIncus",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enablePermission": "admin.plugins.manage",
        "fields": [
          {
            "key": "level",
            "type": "select",
            "labelKey": "settings.host.level.label",
            "descriptionKey": "settings.host.level.description",
            "requires": "enableIncus",
            "default": "read",
            "permission": "admin.plugins.manage",
            "options": [
              {
                "value": "read",
                "labelKey": "settings.host.level.read"
              },
              {
                "value": "operate",
                "labelKey": "settings.host.level.operate"
              },
              {
                "value": "manage",
                "labelKey": "settings.host.level.manage"
              }
            ]
          },
          {
            "key": "protected",
            "type": "textarea",
            "labelKey": "settings.host.protected.label",
            "descriptionKey": "settings.host.protected.description",
            "requires": "enableIncus",
            "default": "",
            "permission": "admin.plugins.manage",
            "defaultable": false
          },
          {
            "key": "allowShell",
            "type": "boolean",
            "labelKey": "settings.host.allowShell.label",
            "descriptionKey": "settings.host.allowShell.description",
            "requires": "enableIncus",
            "default": false,
            "permission": "admin.plugins.manage"
          },
          {
            "key": "shell",
            "type": "string",
            "labelKey": "settings.host.shell.label",
            "descriptionKey": "settings.host.shell.description",
            "requires": "allowShell",
            "default": "",
            "permission": "admin.plugins.manage"
          },
          {
            "key": "allowReveal",
            "type": "boolean",
            "labelKey": "settings.host.allowReveal.label",
            "descriptionKey": "settings.host.allowReveal.description",
            "requires": "enableIncus",
            "default": false,
            "permission": "admin.plugins.manage"
          },
          {
            "key": "incusCommand",
            "type": "select",
            "labelKey": "settings.host.incusCommand.label",
            "descriptionKey": "settings.host.incusCommand.description",
            "requires": "enableIncus",
            "default": "incus",
            "permission": "admin.plugins.manage",
            "options": [
              {
                "value": "incus",
                "labelKey": "settings.host.incusCommand.plain"
              },
              {
                "value": "sudo",
                "labelKey": "settings.host.incusCommand.sudo"
              }
            ]
          },
          {
            "key": "pollSeconds",
            "type": "number",
            "labelKey": "settings.host.pollSeconds.label",
            "descriptionKey": "settings.host.pollSeconds.description",
            "requires": "enableIncus",
            "default": 15,
            "min": 10,
            "max": 300,
            "permission": "admin.plugins.manage"
          }
        ]
      }
    },
    "operations": {
      "actions": [
        {
          "id": "incus.list-instances",
          "titleKey": "operations.list-instances.title",
          "scope": "host",
          "risk": "read",
          "permission": "read",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "palette": false
          }
        },
        {
          "id": "incus.start",
          "titleKey": "operations.start.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "change",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "idempotent": true,
          "icon": "Play"
        },
        {
          "id": "incus.stop",
          "titleKey": "operations.stop.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "change",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "idempotent": true,
          "icon": "Square"
        },
        {
          "id": "incus.restart",
          "titleKey": "operations.restart.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "change",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "icon": "RotateCw"
        },
        {
          "id": "incus.freeze",
          "titleKey": "operations.freeze.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "change",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "idempotent": true,
          "icon": "Pause"
        },
        {
          "id": "incus.unfreeze",
          "titleKey": "operations.unfreeze.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "change",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "idempotent": true,
          "icon": "Play"
        },
        {
          "id": "incus.snapshot-create",
          "titleKey": "operations.snapshot-create.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "change",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "icon": "Camera",
          "inputs": [
            {
              "key": "name",
              "type": "string",
              "labelKey": "operations.snapshot-create.name",
              "pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]{0,62})?$"
            },
            {
              "key": "expiry",
              "type": "select",
              "labelKey": "operations.snapshot-create.expiry",
              "default": "7d",
              "options": [
                {
                  "value": "",
                  "labelKey": "operations.snapshot-create.never"
                },
                {
                  "value": "1d",
                  "labelKey": "operations.snapshot-create.day"
                },
                {
                  "value": "7d",
                  "labelKey": "operations.snapshot-create.week"
                },
                {
                  "value": "30d",
                  "labelKey": "operations.snapshot-create.month"
                }
              ]
            }
          ]
        },
        {
          "id": "incus.snapshot-restore",
          "titleKey": "operations.snapshot-restore.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "destructive",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "icon": "History",
          "inputs": [
            {
              "key": "snapshot",
              "type": "string",
              "labelKey": "operations.snapshot.label",
              "required": true,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
            }
          ]
        },
        {
          "id": "incus.snapshot-delete",
          "titleKey": "operations.snapshot-delete.title",
          "scope": "resource",
          "resource": "incus.instance",
          "risk": "destructive",
          "permission": "operate",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableIncus": true
            }
          },
          "surfaces": {
            "assistant": false,
            "mcp": false
          },
          "exclusive": true,
          "icon": "Trash2",
          "inputs": [
            {
              "key": "snapshot",
              "type": "string",
              "labelKey": "operations.snapshot.label",
              "required": true,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
            }
          ]
        }
      ],
      "resources": [
        {
          "id": "incus.instance",
          "titleKey": "operations.instance.title",
          "icon": "Boxes",
          "list": "incus.list-instances",
          "key": "key",
          "name": "name",
          "status": "status",
          "tab": "incus",
          "columns": [
            {
              "key": "type",
              "titleKey": "operations.instance.type"
            },
            {
              "key": "project",
              "titleKey": "operations.instance.project"
            },
            {
              "key": "address",
              "titleKey": "operations.instance.address"
            }
          ],
          "filters": ["status"]
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "incus-hosts",
        "titleKey": "card.title",
        "icon": "Boxes"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
