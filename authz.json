{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "routes": {
    "GET /plugin-api/incus/hosts": {
      "access": "user",
      "permission": "incus.read",
      "filtered": true,
      "note": "Lists only hosts the caller can see that have Incus turned on"
    },
    "GET /plugin-api/incus/hosts/:hostId/version": {
      "access": "user",
      "permission": "incus.read",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "params": {
        "hostId": "host"
      },
      "allowed": "any",
      "note": "Needs a real host running Incus to answer; refusals are still checked"
    },
    "GET /plugin-api/incus/hosts/:hostId/instances": {
      "access": "user",
      "permission": "incus.read",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "params": {
        "hostId": "host"
      },
      "allowed": "any",
      "note": "Needs a real host running Incus to answer; refusals are still checked"
    },
    "GET /plugin-api/incus/hosts/:hostId/instances/:project/:name/processes": {
      "access": "user",
      "permission": "incus.read",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "params": {
        "hostId": "host",
        "project": "default",
        "name": "authz-instance"
      },
      "allowed": "any",
      "note": "Needs a real host running Incus to answer; refusals are still checked"
    },
    "GET /plugin-api/incus/hosts/:hostId/instances/:project/:name/logs": {
      "access": "user",
      "permission": "incus.read",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "params": {
        "hostId": "host",
        "project": "default",
        "name": "authz-instance"
      },
      "allowed": "any",
      "note": "Needs a real host running Incus to answer; refusals are still checked"
    },
    "GET /plugin-api/incus/hosts/:hostId/instances/:project/:name/details": {
      "access": "user",
      "permission": "incus.read",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "params": {
        "hostId": "host",
        "project": "default",
        "name": "authz-instance"
      },
      "allowed": "any",
      "note": "Needs a real host running Incus to answer; refusals are still checked"
    },
    "WS /plugin-ws/incus/console": {
      "access": "user",
      "permission": "incus.shell",
      "resource": {
        "kind": "host",
        "min": "edit"
      },
      "send": [
        {
          "type": "connect",
          "data": {
            "hostId": "{{host}}",
            "project": "default",
            "name": "authz-instance"
          }
        }
      ],
      "allowed": "any",
      "note": "Needs a real host running Incus; refusals are still checked"
    },
    "POST /plugin-api/incus/hosts/:hostId/instances/:project/:name/actions/:action": {
      "access": "user",
      "permission": "incus.read",
      "resource": {
        "kind": "host",
        "min": "edit"
      },
      "params": {
        "hostId": "host",
        "project": "default",
        "name": "authz-instance",
        "action": "restart"
      },
      "body": {
        "input": {}
      },
      "destructive": true,
      "allowed": "any",
      "note": "Runs through Termix operations, which check incus.operate and edit access; needs a real host"
    },
    "GET /plugin-api/incus/summary": {
      "access": "user",
      "permission": "incus.read",
      "filtered": true,
      "note": "Counts only for hosts the caller can see that have Incus turned on"
    }
  }
}
